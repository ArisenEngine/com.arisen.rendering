{
  "id": "com.arisen.rendering",
  "name": "Arisen Rendering Pipeline",
  "version": "1.0.0",
  "engine": {
    "minVersion": "0.1.0"
  },
  "layer": "domain",
  "author": "Arisen Team",
  "description": "RenderPipeline interfaces, RenderGraph, and low-level shading implementations",
  "entry": {
    "assembly": "Com.Arisen.Rendering.dll",
    "class": "ArisenEngine.Rendering.RenderingPackage"
  },
  "services": {
    "provides": [
      "ArisenEngine.Rendering.IRuntimeShaderCookRecipeRegistry",
      "ArisenEngine.Rendering.IGraphicsDeviceLifecycleService"
    ],
    "requires": [
      "ArisenEngine.Core.Assets.IAssetDatabase",
      "ArisenEngine.Core.Assets.IRuntimeAssetCookerRegistry",
      "ArisenEngine.Resources.Serialization.IWorldOriginService",
      "ArisenKernel.Contracts.IWindowProvider",
      {
        "interface": "ArisenKernel.Contracts.IRHIBackend",
        "deferred": true
      },
      {
        "interface": "ArisenKernel.Contracts.IRHIDevice",
        "deferred": true
      }
    ]
  },
  "subsystems": [
    {
      "class": "ArisenEngine.Rendering.RuntimeRHIWarmupSubsystem",
      "phase": "PostInit",
      "priority": 0
    },
    {
      "class": "ArisenEngine.Rendering.RenderSubsystem",
      "phase": "Running",
      "priority": 100
    }
  ],
  "dependencies": {
    "com.arisen.core": "1.0.0",
    "com.arisen.ecs": "1.0.0",
    "com.arisen.core.native": "1.0.0",
    "com.arisen.dag": "1.0.0",
    "com.arisen.taskgraph": "1.0.0",
    "com.arisen.resources": "1.0.0"
  },
  "nugetDependencies": {
    "StbImageSharp": "2.30.15",
    "YamlDotNet": "16.3.0"
  }
}
